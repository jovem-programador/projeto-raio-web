SECRET_KEY=troque-por-uma-chave-forte

# Usuario administrador criado automaticamente quando ainda nao existir admin.
# Troque a senha antes de expor o sistema.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@projetoraio.local
DEFAULT_ADMIN_PASSWORD=admin123

# Portas publicadas no host.
FRONTEND_PORT=3010
BACKEND_PORT=8000

# ODA dentro do Docker.
# Linux com pacote .deb instalado geralmente usa:
# ODA_HOST_DIR=/usr/bin/ODAFileConverter_27.1.0.0
# ODA_REAL_PATH=/opt/oda/ODAFileConverter
#
# Em Windows/local, coloque a instalacao compativel em ./oda e mantenha
ODA_HOST_DIR=/usr/bin/ODAFileConverter_27.1.0.0
ODA_REAL_PATH=/opt/oda/ODAFileConverter
